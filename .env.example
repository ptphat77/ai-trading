# Candle Data (CSV source — can be exported from MT5, TradingView, Dukascopy, etc.)
CSV_DATA_PATH=./data/candles.csv

# AI Provider Selection ('qwen' | 'gemini')
AI_PROVIDER=qwen
AI_RATE_LIMIT_DELAY_MS=300

# Alibaba Cloud DashScope (Qwen) - Recommended
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Google Gemini (Alternative)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Strategy
SYMBOL=XAU_USD
TIMEFRAME=M5
CANDLE_COUNT=300
RISK_PER_TRADE=0.0175       # 1.75%
MIN_CONFIDENCE=0.7

# Indicators
MA_TYPE=EMA
MA_FAST_PERIOD=9
MA_SLOW_PERIOD=100
RSI_PERIOD=14
RSI_OVERSOLD=36
RSI_OVERBOUGHT=64
RSI_LOOKBACK_CANDLES=18
EMA_CONFIRMATION_WINDOW=5
ATR_PERIOD=14
DEFAULT_SL_ATR_MULTIPLIER=1.5
DEFAULT_TP_ATR_MULTIPLIER=1.1

# Bot
LOOP_INTERVAL_MS=300000     # 5 minutes

# Chart Viewer
CHART_PORT=3400             # Port for chart viewer web server
TRADE_LOG_PATH=./logs/backtest_trade_log_sample.json # Path to trade log for chart viewer

# Broker REST API (Phase 3 & 4 only — Paper Trading / Live Trading)
# BROKER_API_KEY=your_broker_api_key_here
# BROKER_ACCOUNT_ID=your_account_id_here
# BROKER_BASE_URL=https://api-fxpractice.yourbroker.com    # Demo URL
