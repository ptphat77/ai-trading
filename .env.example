# Candle Data (CSV source — can be exported from MT5, TradingView, Dukascopy, etc.)
CSV_DATA_PATH=./data/candles.csv

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Strategy
SYMBOL=XAU_USD
TIMEFRAME=M5
CANDLE_COUNT=100
RISK_PER_TRADE=0.01         # 1%
MIN_CONFIDENCE=0.7

# Bot
LOOP_INTERVAL_MS=300000     # 5 minutes

# Broker REST API (Phase 3 & 4 only — Paper Trading / Live Trading)
# BROKER_API_KEY=your_broker_api_key_here
# BROKER_ACCOUNT_ID=your_account_id_here
# BROKER_BASE_URL=https://api-fxpractice.yourbroker.com    # Demo URL
